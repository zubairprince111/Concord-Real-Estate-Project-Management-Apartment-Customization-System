@model Final.Models.PaymentReceiptModel
@{
    Layout = null;
    string backUrl = Session["UserRole"] != null && Session["UserRole"].ToString() == "Client"
        ? Url.Action("Payments", "Client")
        : Url.Action("ClientPayments", "Accounts");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Payment Receipt #@Model.PaymentID - Concord Real Estate</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="@("https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css")">
    <link href="~/Content/dashboard.css" rel="stylesheet" />
    <style>
        body { background-color: #f8fafc; font-family: 'Inter', sans-serif; margin: 0; padding: 0; }
        .receipt-page-container { display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 40px 20px; box-sizing: border-box; }
        .receipt-paper-card { background: #ffffff; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08); padding: 40px; width: 100%; max-width: 520px; }
        .receipt-header-branding { text-align: center; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #f1f5f9; }
        .receipt-brand-name { font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0; letter-spacing: -0.01em; }
        .receipt-sub-badge { display: inline-block; font-size: 11px; font-weight: 700; background: #e2e8f0; color: #334155; padding: 3px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
        .receipt-details-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        .receipt-details-table td { padding: 10px 0; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; }
        .receipt-details-table tr:last-child td { border-bottom: none; }
        .receipt-detail-label { color: #64748b; font-weight: 500; }
        .receipt-detail-value { font-weight: 600; color: #0f172a; text-align: right; }
        .receipt-amount-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 24px; }
        .receipt-amount-title { font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
        .receipt-amount-number { font-size: 32px; font-weight: 800; color: #16a34a; line-height: 1; }
        .receipt-actions { display: flex; justify-content: center; gap: 12px; }
        @@media print {
            body { background: #ffffff; }
            .receipt-page-container { padding: 0; min-height: auto; }
            .receipt-paper-card { box-shadow: none; border: none; padding: 0; width: 100%; }
            .receipt-actions { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="receipt-page-container">
        <div class="receipt-paper-card">
            <div class="receipt-header-branding">
                <h1 class="receipt-brand-name">CONCORD REAL ESTATE</h1>
                <span class="receipt-sub-badge">Official Payment Receipt</span>
            </div>

            <table class="receipt-details-table">
                <tr>
                    <td class="receipt-detail-label">Receipt Number</td>
                    <td class="receipt-detail-value">#REC-@Model.PaymentID</td>
                </tr>
                <tr>
                    <td class="receipt-detail-label">Payment Date</td>
                    <td class="receipt-detail-value">@Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                </tr>
                <tr>
                    <td class="receipt-detail-label">Project</td>
                    <td class="receipt-detail-value">@Model.ProjectName</td>
                </tr>
                <tr>
                    <td class="receipt-detail-label">@Model.PartyLabel</td>
                    <td class="receipt-detail-value">@Model.PartyName</td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.ExtraDetail))
                {
                    <tr>
                        <td class="receipt-detail-label">Unit Details</td>
                        <td class="receipt-detail-value">@Model.ExtraDetail</td>
                    </tr>
                }
                <tr>
                    <td class="receipt-detail-label">@Model.TotalLabel</td>
                    <td class="receipt-detail-value">Tk @Model.TotalPrice.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="receipt-detail-label">Remaining Balance Due</td>
                    <td class="receipt-detail-value" style="color: @(Model.Due > 0 ? "#b45309" : "#16a34a");">Tk @Model.Due.ToString("N2")</td>
                </tr>
            </table>

            <div class="receipt-amount-box">
                <div class="receipt-amount-title">Total Amount Paid</div>
                <div class="receipt-amount-number">Tk @Model.Amount.ToString("N2")</div>
            </div>

            <div class="receipt-actions">
                <button type="button" class="btn-erp-primary" onclick="window.print()">
                    <i class="ti ti-printer" aria-hidden="true"></i> Print Receipt
                </button>
                <a href="@backUrl" onclick="if (history.length > 1) { history.back(); return false; }" class="btn-erp-secondary">Back</a>
            </div>
        </div>
    </div>
</body>
</html>
