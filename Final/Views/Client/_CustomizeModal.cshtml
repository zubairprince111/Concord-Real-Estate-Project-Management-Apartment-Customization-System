@model Final.Models.CustomizeViewModel
@using System.Linq
<div class="modal fade" id="customizeModal_@Model.BookingID" tabindex="-1" role="dialog" aria-labelledby="customizeModalLabel_@Model.BookingID" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);">
            <div class="modal-header" style="background-color: var(--primary); color: #ffffff; padding: 20px 24px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="customizeModalLabel_@Model.BookingID" style="font-size: 18px; font-weight: 700; margin: 0;">Customize Your Unit Finishing</h4>
                <div style="font-size: 12.5px; color: #94a3b8; margin-top: 4px;">Booking #@Model.BookingID &mdash; @Model.ProjectName, @Model.BuildingName, Flat @Model.FlatNumber</div>
            </div>
            
            @using (Html.BeginForm("SaveCustomization", "Client", FormMethod.Post, new { autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.BookingID" />
                <div class="modal-body" style="padding: 24px; background-color: #f8fafc;">

                    <!-- Price Summary Card -->
                    <div class="price-summary" data-base-price="@Model.UnitBasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="background: #ffffff; border: 1px solid #e2e8f0; border-left: 4px solid var(--primary-blue); border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 24px;">
                        <div class="row" style="display: flex; justify-content: space-between; font-size: 13.5px; color: #475569; padding: 4px 0;"><span>Base Flat Unit Price</span><span style="font-weight: 600;">Tk @Model.UnitBasePrice.ToString("N0")</span></div>
                        <div class="row upgrades" style="display: flex; justify-content: space-between; font-size: 13.5px; color: #16a34a; font-weight: 600; padding: 4px 0;"><span>Approved Customization Upgrades</span><span class="live-upgrades">+Tk @Model.CurrentExtraTotal.ToString("N0")</span></div>
                        <div class="row pending" style="display: flex; justify-content: space-between; font-size: 12.5px; color: #b45309; padding: 4px 0;"><span>Awaiting Approval (Not Billed Yet)</span><span class="live-pending">Tk @Model.PendingExtraTotal.ToString("N0")</span></div>
                        <div class="row total" style="display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; color: #0f172a; border-top: 1px solid #e2e8f0; margin-top: 8px; padding-top: 10px;"><span>Total Estimated Price</span><span class="live-total" style="color: #2563eb;">Tk @((Model.UnitBasePrice + Model.CurrentExtraTotal).ToString("N0"))</span></div>
                    </div>

                    @{ var rejected = Model.Products.Where(p => p.IsCustomizableCategory && p.Status == "Rejected").ToList(); }
                    @if (rejected.Any())
                    {
                        <div class="alert-erp alert-erp-danger" style="margin-bottom: 20px;">
                            <i class="ti ti-alert-circle" aria-hidden="true"></i>
                            <div>
                                <strong>@rejected.Count customization item(s) require review.</strong> The Project Manager rejected:
                                <ul style="margin: 4px 0 0 0; padding-left: 18px;">
                                    @foreach (var r in rejected)
                                    {
                                        <li>@r.ProductName@(string.IsNullOrEmpty(r.Description) ? "" : " - " + r.Description) @(string.IsNullOrEmpty(r.Remarks) ? "" : "— " + r.Remarks)</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    @if (Model.CategoryNames.Any())
                    {
                        var groupsByCategory = Model.Products.GroupBy(x => x.CategoryName).ToDictionary(g => g.Key);
                        foreach (var categoryName in Model.CategoryNames)
                        {
                            <h4 class="category-heading" style="font-size: 15px; font-weight: 700; color: #1e293b; margin: 24px 0 12px 0;">@categoryName</h4>
                            if (!groupsByCategory.ContainsKey(categoryName))
                            {
                                <div class="coming-soon-note" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 12px 16px; font-size: 13px; color: #64748b;">
                                    <i class="ti ti-clock" aria-hidden="true"></i>
                                    <span><strong>Options Coming Soon</strong> &mdash; finishing materials for @categoryName will appear once assigned.</span>
                                </div>
                                continue;
                            }

                            var group = groupsByCategory[categoryName];
                            bool isSingleProductCategory = group.Count() == 1;
                            <div class="category-box" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 6px 16px;">
                                @foreach (var p in group)
                                {
                                    if (!p.IsCustomizableCategory)
                                    {
                                        <div class="product-row readonly" style="padding: 12px 0; border-bottom: 1px solid #f1f5f9;">
                                            <div class="product-info">
                                                <div class="name" style="font-weight: 600; font-size: 14px; color: #1e293b;">@p.ProductName</div>
                                                @if (!string.IsNullOrEmpty(p.Description))
                                                {
                                                    <div class="desc" style="font-size: 12px; color: #64748b;">@p.Description</div>
                                                }
                                                <div class="price-impact-included" style="font-size: 12px; color: #16a34a; font-weight: 600;">Standard Specification (Included)</div>
                                            </div>
                                        </div>
                                        continue;
                                    }

                                    bool isRejected = p.Status == "Rejected";
                                    string extraCostForUnit = (p.ExtraCost * Model.UnitSizeSqFt).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    <div class="product-row @(isRejected ? "rejected" : "")" style="display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1f5f9; @(isRejected ? "background: #fef2f2; padding: 12px; border-radius: 8px;" : "")">
                                        @if (isSingleProductCategory)
                                        {
                                            <input type="checkbox" name="productIds" value="@p.ProductID" data-extra-cost="@extraCostForUnit" data-approved="@(p.IsSelected && p.Status == "Approved" ? "1" : "0")" @(p.IsSelected ? "checked" : "") style="width: 18px; height: 18px; margin-top: 2px;" />
                                        }
                                        else
                                        {
                                            <input type="radio" name="category_@group.Key" value="@p.ProductID" data-extra-cost="@extraCostForUnit" data-approved="@(p.IsSelected && p.Status == "Approved" ? "1" : "0")" @(p.IsSelected ? "checked" : "") style="width: 18px; height: 18px; margin-top: 2px;" />
                                        }
                                        <div class="product-info" style="flex: 1;">
                                            <div class="name" style="font-weight: 600; font-size: 14px; color: #1e293b;">@p.ProductName</div>
                                            @if (!string.IsNullOrEmpty(p.Description))
                                            {
                                                <div class="desc" style="font-size: 12.5px; color: #64748b;">@p.Description</div>
                                            }
                                            @if (!string.IsNullOrEmpty(p.Status))
                                            {
                                                <div style="margin-top: 4px;"><span class="status-pill status-@p.Status">@p.StatusLabel</span></div>
                                            }
                                            @if (p.HasEarlierRejection)
                                            {
                                                <div style="font-size: 12px; color: #dc2626; margin-top: 2px;">Earlier rejected@(string.IsNullOrEmpty(p.EarlierRejectionReason) ? "" : ": " + p.EarlierRejectionReason)</div>
                                            }
                                            @if (!p.IsStillOffered)
                                            {
                                                <div style="margin-top: 4px;"><span class="status-pill status-Pending">No longer offered</span> <small style="color: #64748b;">Your earlier choice stands.</small></div>
                                            }
                                            @if (p.IsDefaultOption)
                                            {
                                                <div class="price-impact-included" style="font-size: 12px; color: #16a34a; font-weight: 600; margin-top: 2px;">Included at no extra charge</div>
                                            }
                                            else if (p.ExtraCost > 0)
                                            {
                                                <div class="price-impact-premium" style="font-size: 12.5px; color: #b45309; font-weight: 600; margin-top: 2px;">+Tk @((p.ExtraCost * Model.UnitSizeSqFt).ToString("N0")) <small style="color: #64748b; font-weight: 400;">(Tk @p.ExtraCost.ToString("N2")/sqft x @Model.UnitSizeSqFt.ToString("N0") sqft)</small></div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p style="font-size: 13px; color: #64748b;">No material categories are configured yet.</p>
                    }
                </div>
                <div class="modal-footer" style="background-color: #ffffff; border-top: 1px solid #e2e8f0; padding: 16px 24px;">
                    <button type="button" class="btn-erp-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-erp-primary">Save Selections</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var modalId = 'customizeModal_@Model.BookingID';
        var modalEl = document.getElementById(modalId);
        var form = modalEl ? modalEl.querySelector('form') : null;
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var saveBtn = form.querySelector('button[type="submit"]');
            saveBtn.disabled = true;

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin',
                body: new FormData(form)
            })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data.success) { var refused = new Error('save failed'); refused.userMessage = data.message; throw refused; }
                    $('#' + modalId).one('hidden.bs.modal', function () { window.location.href = '@Url.Action("MyBookings", "Client")'; }).modal('hide');
                })
                .catch(function (err) {
                    saveBtn.disabled = false;
                    alert(err && err.userMessage ? err.userMessage : 'Sorry, your selections could not be saved. Please try again.');
                });
        });
    })();
</script>
<script>
    (function () {
        var modalEl = document.getElementById('customizeModal_@Model.BookingID');
        var form = modalEl ? modalEl.querySelector('form') : null;
        var summary = modalEl ? modalEl.querySelector('.price-summary') : null;
        if (!form || !summary) return;

        var basePrice = parseFloat(summary.getAttribute('data-base-price')) || 0;
        var upgradesEl = summary.querySelector('.live-upgrades');
        var pendingEl = summary.querySelector('.live-pending');
        var totalEl = summary.querySelector('.live-total');

        function formatTk(amount) {
            return Math.round(amount).toLocaleString('en-US');
        }

        form.addEventListener('change', function (e) {
            if (!e.target.matches('input[type="checkbox"][data-extra-cost], input[type="radio"][data-extra-cost]')) return;

            var approved = 0, awaiting = 0;
            form.querySelectorAll('input[data-extra-cost]:checked').forEach(function (input) {
                var cost = parseFloat(input.getAttribute('data-extra-cost')) || 0;
                if (input.getAttribute('data-approved') === '1') { approved += cost; } else { awaiting += cost; }
            });

            upgradesEl.textContent = '+Tk ' + formatTk(approved);
            pendingEl.textContent = 'Tk ' + formatTk(awaiting);
            totalEl.textContent = 'Tk ' + formatTk(basePrice + approved);
        });
    })();
</script>
