@model Final.Models.EditUserViewModel
@{
    var roleOptions = ViewBag.RoleOptions as System.Collections.Generic.List<System.Web.Mvc.SelectListItem>;
}
<div class="modal fade" id="editModal_@Model.UserID" tabindex="-1" role="dialog" aria-labelledby="editModalLabel_@Model.UserID" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);">
            <div class="modal-header" style="background-color: var(--primary); color: #ffffff; padding: 18px 24px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="editModalLabel_@Model.UserID" style="font-size: 16px; font-weight: 700; margin: 0;">Edit User Account #@Model.UserID</h4>
            </div>
            @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
            {
                <div class="modal-body" style="padding: 24px;">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserID)

                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px;">Full Name</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control-erp" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px;">Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control-erp", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px;">Phone Number</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control-erp digits-only" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px;">Role Designation</label>
                        @Html.DropDownListFor(m => m.Role, roleOptions, "-- Select Role --", new { @class = "form-control-erp" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="modal-footer" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 24px;">
                    <button type="button" class="btn-erp-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-erp-primary">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>
