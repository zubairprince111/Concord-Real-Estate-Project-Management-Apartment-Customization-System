@model Final.Models.AddProductViewModel
<div class="modal fade" id="addProductModal" tabindex="-1" role="dialog" aria-labelledby="addProductModalLabel" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);">
            <div class="modal-header" style="background-color: var(--primary); color: #ffffff; padding: 18px 24px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addProductModalLabel" style="font-size: 16px; font-weight: 700; margin: 0;">Add Product Specifications</h4>
            </div>
            @using (Html.BeginForm("AddProduct", "Admin", FormMethod.Post))
            {
                <div class="modal-body" style="padding: 24px;">
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-bottom: 20px;">
                        @Html.LabelFor(m => m.CategoryID, "Category", new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.DropDownListFor(m => m.CategoryID, Model.CategoryOptions, "-- Select Category --", new { @class = "form-control-erp" })
                        @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "text-danger" })
                    </div>

                    <div class="variants-heading" style="font-weight: 700; font-size: 14px; color: var(--text-main); margin-bottom: 12px; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px;">Product Variants</div>
                    @Html.ValidationMessage("Variants", "", new { @class = "text-danger" })
                    <div id="variantsContainer">
                        @for (int i = 0; i < Model.Variants.Count; i++)
                        {
                            <div class="variant-row" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px;">
                                <div class="variant-row-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <span class="variant-number" style="font-weight: 700; font-size: 13px; color: var(--primary-blue);">Variant @(i + 1)</span>
                                    @if (i > 0)
                                    {
                                        <button type="button" class="btn-remove-variant" style="background: none; border: none; color: #dc2626; font-size: 12px; font-weight: 600; cursor: pointer; padding: 0;">Remove</button>
                                    }
                                </div>
                                <div class="form-group" style="margin-bottom: 12px;">
                                    @Html.LabelFor(m => m.Variants[i].Description, "Variant Name / Spec", new { @style = "font-weight: 600; font-size: 12.5px;" })
                                    @Html.TextAreaFor(m => m.Variants[i].Description, new { @class = "form-control-erp", rows = 2, placeholder = "e.g. Italian Marble Finish 60x60cm, Glossy" })
                                    @Html.ValidationMessageFor(m => m.Variants[i].Description, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group" style="margin-bottom: 12px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        @Html.CheckBoxFor(m => m.Variants[i].HasExtraCost, new { @class = "has-extra-cost-checkbox", @style = "width: 16px; height: 16px;" })
                                        @Html.LabelFor(m => m.Variants[i].HasExtraCost, "Has Extra Cost Rate?", new { @style = "font-weight: 600; font-size: 12.5px; margin: 0;" })
                                    </div>
                                </div>
                                <div class="form-group extra-cost-group" style="display: none; margin-bottom: 0;">
                                    <label style="font-weight: 600; font-size: 12.5px;">Extra Cost Rate (Tk per sqft)</label>
                                    @Html.TextBoxFor(m => m.Variants[i].ExtraCost, new { @class = "form-control-erp numeric-only extra-cost-input", type = "text", inputmode = "decimal", placeholder = "Enter extra cost per sqft" })
                                    @Html.ValidationMessageFor(m => m.Variants[i].ExtraCost, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                    </div>

                    <button type="button" id="addVariantBtn" class="btn-erp-secondary" style="width: 100%; border: 1px dashed #cbd5e1; font-size: 13px; justify-content: center; margin-bottom: 16px;">
                        <i class="ti ti-plus" aria-hidden="true"></i> Add Another Variant
                    </button>

                    <div id="variantRowTemplate" class="variant-row" style="display: none; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px;">
                        <div class="variant-row-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span class="variant-number" style="font-weight: 700; font-size: 13px; color: var(--primary-blue);">Variant</span>
                            <button type="button" class="btn-remove-variant" style="background: none; border: none; color: #dc2626; font-size: 12px; font-weight: 600; cursor: pointer; padding: 0;">Remove</button>
                        </div>
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: 600; font-size: 12.5px;">Variant Name / Spec</label>
                            <textarea name="Variants[__INDEX__].Description" class="form-control-erp" rows="2" placeholder="e.g. Italian Marble Finish 60x60cm, Glossy"></textarea>
                        </div>
                        <div class="form-group" style="margin-bottom: 12px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <input type="checkbox" name="Variants[__INDEX__].HasExtraCost" value="true" class="has-extra-cost-checkbox" style="width: 16px; height: 16px;" />
                                <input type="hidden" name="Variants[__INDEX__].HasExtraCost" value="false" />
                                <label style="font-weight: 600; font-size: 12.5px; margin: 0;">Has Extra Cost Rate?</label>
                            </div>
                        </div>
                        <div class="form-group extra-cost-group" style="display: none; margin-bottom: 0;">
                            <label style="font-weight: 600; font-size: 12.5px;">Extra Cost Rate (Tk per sqft)</label>
                            <input name="Variants[__INDEX__].ExtraCost" class="form-control-erp numeric-only extra-cost-input" type="text" inputmode="decimal" placeholder="Enter extra cost per sqft" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 24px;">
                    <button type="button" class="btn-erp-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-erp-primary">Save Product</button>
                </div>
            }
        </div>
    </div>
</div>
