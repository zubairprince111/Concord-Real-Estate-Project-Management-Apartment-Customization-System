@model Final.Models.ProjectModel
<div class="modal fade" id="createModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);">
            <div class="modal-header" style="background-color: var(--primary); color: #ffffff; padding: 18px 24px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8;"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createModalLabel" style="font-size: 16px; font-weight: 700; margin: 0;">New Project</h4>
            </div>
            @using (Html.BeginForm("Create", "Project", FormMethod.Post))
            {
                <div class="modal-body" style="padding: 24px;">
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.ProjectName, new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control-erp" })
                        @Html.ValidationMessageFor(m => m.ProjectName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.Location, new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control-erp", onkeypress = "return /[a-zA-Z\\s,.-]/.test(event.key)" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.Budget, new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBox("Budget", "", new { @class = "form-control-erp numeric-only", placeholder = "Enter budget" })
                        @Html.ValidationMessageFor(m => m.Budget, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.StartDate, new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control-erp", type = "date" })
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.EstimatedCompletionDate, "Estimated Completion Date", new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.EstimatedCompletionDate, "{0:yyyy-MM-dd}", new { @class = "form-control-erp", type = "date" })
                        @Html.ValidationMessageFor(m => m.EstimatedCompletionDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 14px;">
                        @Html.LabelFor(m => m.MaxBuildings, "Max Buildings", new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.MaxBuildings, new { @class = "form-control-erp numeric-only" })
                        @Html.ValidationMessageFor(m => m.MaxBuildings, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        @Html.LabelFor(m => m.TotalAreaSqFt, "Total Area (SqFt)", new { @style = "font-weight: 600; font-size: 13px; color: var(--text-main);" })
                        @Html.TextBoxFor(m => m.TotalAreaSqFt, new { @class = "form-control-erp numeric-only" })
                        @Html.ValidationMessageFor(m => m.TotalAreaSqFt, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="modal-footer" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 24px;">
                    <button type="button" class="btn-erp-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-erp-primary">Create Project</button>
                </div>
            }
        </div>
    </div>
</div>
