@model Final.Models.ProjectModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Edit Project - Concord Real Estate</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/no-spinner.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Arial, sans-serif; }
        .topbar { background-color: #1F3A5F; color: #fff; padding: 16px 30px; display: flex; justify-content: space-between; align-items: center; }
        .topbar h1 { margin: 0; font-size: 20px; font-weight: 600; }
        .topbar .user-info { font-size: 13px; color: #c9d6e6; }
        .topbar .user-info a { color: #fff; margin-left: 15px; text-decoration: underline; }
        .content { padding: 30px; display: flex; justify-content: center; }
        .form-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 30px; width: 100%; max-width: 480px; }
        .form-card h2 { color: #1F3A5F; font-size: 20px; margin-bottom: 20px; }
        .form-group label { font-weight: 600; color: #333; font-size: 13px; }
        .btn-save { background-color: #1F3A5F; color: #fff; border: none; padding: 9px 22px; border-radius: 4px; font-weight: 600; }
        .btn-save:hover { background-color: #16283F; color: #fff; }
        .btn-cancel { padding: 9px 22px; margin-left: 8px; color: #1F3A5F; text-decoration: none; }
        .text-danger { font-size: 12px; }
        .validation-summary-errors { color: #b00020; font-size: 13px; }
    </style>
</head>
<body>
    <div class="topbar">
        <h1><a href="@Url.Action("Index", "Dashboard")" style="color: inherit; text-decoration: none;">Concord Real Estate Development</a></h1>
        <div class="user-info">
            @Session["FullName"] (@Session["UserRole"])
            @Html.ActionLink("Logout", "Logout", "Account")
        </div>
    </div>
    <div style="background-color: #EEF2F7; padding: 8px 30px; border-bottom: 1px solid #d7e0ea; font-size: 13px;">
        <a href="@Url.Action("Index", "Dashboard")" style="color: #1F3A5F; font-weight: 600; text-decoration: none;">Dashboard</a>
        <span style="color: #8a99ab; margin: 0 6px;">&gt;</span>
        <span style="color: #556174;">Edit Project</span>
    </div>
    <div class="content">
        <div class="form-card">
            <h2>Edit Project</h2>
            @using (Html.BeginForm("Edit", "Project", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ProjectID)

                <div class="form-group">
                    @Html.LabelFor(m => m.ProjectName)
                    @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ProjectName, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Location)
                    @Html.TextBoxFor(m => m.Location, new { @class = "form-control", onkeypress = "return /[a-zA-Z\\s,.-]/.test(event.key)" })
                    @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Budget)
                    @Html.TextBoxFor(m => m.Budget, new { @class = "form-control numeric-only" })
                    @Html.ValidationMessageFor(m => m.Budget, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.StartDate)
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.EstimatedCompletionDate, "Estimated Completion Date")
                    @Html.TextBoxFor(m => m.EstimatedCompletionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.EstimatedCompletionDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Status)
                    @Html.DropDownListFor(m => m.Status, (IEnumerable<System.Web.Mvc.SelectListItem>)ViewBag.StatusOptions, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-save">Save Changes</button>
                @Html.ActionLink("Cancel", "Index", "Project", null, new { @class = "btn-cancel" })
            }
        </div>
    </div>
    <script src="~/Scripts/numeric-input.js"></script>
</body>
</html>
