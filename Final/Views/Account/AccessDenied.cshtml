@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access Denied - Concord ERP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="@("https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css")">
    <link href="~/Content/dashboard.css" rel="stylesheet" />
    <style>
        body { background-color: #f8fafc; font-family: 'Inter', sans-serif; margin: 0; }
        .denied-wrapper { display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .denied-card { background: #ffffff; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08); padding: 48px 40px; text-align: center; max-width: 440px; width: 100%; }
    </style>
</head>
<body>
    <div class="denied-wrapper">
        <div class="denied-card">
            <div style="width: 56px; height: 56px; border-radius: 12px; background: #fef2f2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px auto;">
                <i class="ti ti-shield-x" aria-hidden="true"></i>
            </div>
            <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0;">Access Denied</h2>
            <p style="font-size: 14px; color: #64748b; margin: 0 0 24px 0; line-height: 1.5;">You do not have permission or role authorization to access this page.</p>
            <a href="@Url.Action("Index", "Dashboard")" class="btn-erp-primary" style="justify-content: center;">
                <i class="ti ti-arrow-left" aria-hidden="true"></i> Return to Dashboard
            </a>
        </div>
    </div>
</body>
</html>
