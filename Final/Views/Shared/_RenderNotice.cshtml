@*
    Render Server Cold Start Notification Partial (Centered Modal, 4s Timer, SVG Icons)
*@
<style>
    .render-notice-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        z-index: 99998;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .render-notice-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .render-notice-popup {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 99999;
        max-width: 440px;
        width: calc(100vw - 40px);
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.98), rgba(30, 41, 59, 0.98));
        border: 1px solid rgba(245, 158, 11, 0.4);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 25px rgba(245, 158, 11, 0.2);
        color: #f8fafc;
        padding: 24px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        transform: translate(-50%, -45%) scale(0.92);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease, visibility 0.35s ease;
        overflow: hidden;
    }
    .render-notice-popup.active {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
        visibility: visible;
    }

    .render-notice-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }
    .render-notice-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.35);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .render-notice-pulse {
        width: 8px;
        height: 8px;
        background-color: #f59e0b;
        border-radius: 50%;
        box-shadow: 0 0 0 rgba(245, 158, 11, 0.4);
        animation: renderNoticePulse 1.8s infinite;
        display: inline-block;
    }
    @@keyframes renderNoticePulse {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
        70% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    .render-notice-close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 6px;
        transition: color 0.2s, background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .render-notice-close-btn:hover {
        color: #f8fafc;
        background: rgba(255, 255, 255, 0.1);
    }
    .render-notice-body h4 {
        margin: 0 0 8px 0;
        font-size: 17px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .render-notice-body p {
        margin: 0 0 16px 0;
        font-size: 13.5px;
        line-height: 1.55;
        color: #cbd5e1;
    }
    .render-notice-highlight {
        color: #fbbf24;
        font-weight: 700;
    }
    .render-notice-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .render-notice-timer-text {
        font-size: 11.5px;
        color: #94a3b8;
        font-weight: 500;
    }
    .render-notice-btn {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        transition: all 0.2s ease;
    }
    .render-notice-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4);
    }

    /* 4-second progress bar at bottom of popup */
    .render-notice-progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
        width: 100%;
        transform-origin: left;
    }
    .render-notice-progress-bar.animate {
        animation: renderNoticeTimerBar 4s linear forwards;
    }
    @@keyframes renderNoticeTimerBar {
        from { transform: scaleX(1); }
        to { transform: scaleX(0); }
    }

    /* Floating pill badge when popup is closed/dismissed */
    .render-notice-trigger-pill {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 99997;
        background: #0f172a;
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.35);
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        opacity: 0;
        pointer-events: none;
        transform: scale(0.9);
    }
    .render-notice-trigger-pill.visible {
        opacity: 1;
        pointer-events: auto;
        transform: scale(1);
    }
    .render-notice-trigger-pill:hover {
        background: #1e293b;
        transform: scale(1.04);
    }

    @@media (max-width: 480px) {
        .render-notice-popup {
            padding: 18px;
        }
        .render-notice-trigger-pill {
            bottom: 16px;
            left: 16px;
        }
    }
</style>

<div class="render-notice-overlay" id="renderNoticeOverlay"></div>

<div class="render-notice-popup" id="renderNoticePopup" role="alert">
    <div class="render-notice-header">
        <div class="render-notice-badge">
            <span class="render-notice-pulse"></span> Render Hosting Info
        </div>
        <button type="button" class="render-notice-close-btn" id="renderNoticeCloseBtn" title="Close Notification">&times;</button>
    </div>
    <div class="render-notice-body">
        <h4>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle;">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            Server Warm-Up Notice
        </h4>
        <p>
            This application is hosted on <strong>Render (Free Tier)</strong>. If the server has been idle, initial page loading or actions may take <span class="render-notice-highlight">30 to 50 seconds</span> to spin up. Thank you for your patience!
        </p>
    </div>
    <div class="render-notice-footer">
        <span class="render-notice-timer-text" id="renderNoticeTimerText">Closing in 4s...</span>
        <button type="button" class="render-notice-btn" id="renderNoticeOkBtn">Got it!</button>
    </div>
    <div class="render-notice-progress-bar" id="renderNoticeProgressBar"></div>
</div>

<button type="button" class="render-notice-trigger-pill" id="renderNoticeTriggerPill" title="Server Info">
    <span class="render-notice-pulse"></span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle;">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
    </svg>
    <span>Render Free Tier Notice</span>
</button>

<script>
    (function () {
        var popup = document.getElementById('renderNoticePopup');
        var overlay = document.getElementById('renderNoticeOverlay');
        var closeBtn = document.getElementById('renderNoticeCloseBtn');
        var okBtn = document.getElementById('renderNoticeOkBtn');
        var triggerPill = document.getElementById('renderNoticeTriggerPill');
        var progressBar = document.getElementById('renderNoticeProgressBar');
        var timerText = document.getElementById('renderNoticeTimerText');
        var autoDismissTimer = null;
        var countdownInterval = null;

        if (!popup) return;

        function showPopup() {
            popup.classList.add('active');
            if (overlay) overlay.classList.add('active');
            if (triggerPill) triggerPill.classList.remove('visible');

            // Reset and start 4-second progress bar animation & countdown timer
            if (progressBar) {
                progressBar.classList.remove('animate');
                void progressBar.offsetWidth; // Force reflow
                progressBar.classList.add('animate');
            }

            var secondsLeft = 4;
            if (timerText) timerText.textContent = 'Auto-closing in ' + secondsLeft + 's...';

            if (countdownInterval) clearInterval(countdownInterval);
            countdownInterval = setInterval(function () {
                secondsLeft--;
                if (secondsLeft > 0) {
                    if (timerText) timerText.textContent = 'Auto-closing in ' + secondsLeft + 's...';
                } else {
                    if (timerText) timerText.textContent = 'Closing...';
                    clearInterval(countdownInterval);
                }
            }, 1000);

            if (autoDismissTimer) clearTimeout(autoDismissTimer);
            autoDismissTimer = setTimeout(function () {
                hidePopup(false);
            }, 4000);
        }

        function hidePopup(isManualDismiss) {
            if (autoDismissTimer) clearTimeout(autoDismissTimer);
            if (countdownInterval) clearInterval(countdownInterval);
            if (progressBar) progressBar.classList.remove('animate');

            popup.classList.remove('active');
            if (overlay) overlay.classList.remove('active');
            if (triggerPill) triggerPill.classList.add('visible');

            if (isManualDismiss) {
                try {
                    sessionStorage.setItem('render_notice_dismissed', 'true');
                } catch (e) { }
            }
        }

        var isDismissed = false;
        try {
            isDismissed = sessionStorage.getItem('render_notice_dismissed') === 'true';
        } catch (e) { }

        if (!isDismissed) {
            setTimeout(showPopup, 300);
        } else {
            if (triggerPill) triggerPill.classList.add('visible');
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', function () { hidePopup(true); });
        }
        if (okBtn) {
            okBtn.addEventListener('click', function () { hidePopup(true); });
        }
        if (overlay) {
            overlay.addEventListener('click', function () { hidePopup(true); });
        }
        if (triggerPill) {
            triggerPill.addEventListener('click', showPopup);
        }
    })();
</script>
